{
  "name": "@n-orm/tariff-mf-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "env:dev": "cross-env NODE_ENV=development",
    "env:prod": "cross-env NODE_ENV=production",
    "dev": "concurrently \"npm run build:dev -- --watch --mode development\" \"npm run preview -- --mode development\"",
    "start": "npm run env:dev && npm run dev",
    "build:dev": "npm run env:dev -- vite build",
    "build": "npm run env:prod && vite build",
    "preview": "vite preview --port 4411",
    "format": "biome check --fix --unsafe ./src",
    "lint": "biome check ./src",
    "lint:ts": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "i18next": "^23.16.5",
    "i18next-browser-languagedetector": "^6.1.3",
    "mobx": "^6.13.6",
    "mobx-react-lite": "^4.1.0",
    "mobx-state-tree": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "6.24.0",
    "single-spa": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.4",
    "@sber-orm/biome-config": "*",
    "@sber-orm/components": "^0.228.0",
    "@sber-orm/tsconfig-config": "*",
    "@sber-orm/types__auth-mf-app": "*",
    "@sber-orm/types__components": "*",
    "@sber-orm/types__ui-kit": "*",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-istanbul": "^3.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "happy-dom": "^17.4.4",
    "sass-embedded": "^1.89.0",
    "single-spa-react": "^6.0.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-checker": "^0.10.0",
    "vite-plugin-circular-dependency": "^0.4.1",
    "vite-plugin-externalize-dependencies": "^1.0.1",
    "vite-plugin-single-spa": "^0.9.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18.16.1"
  }
}
